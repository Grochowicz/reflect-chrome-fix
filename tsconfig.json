{
    "compilerOptions": {
        "target": "es6",
        "sourceMap": false,
        "types": ["chrome", "node", "jquery", "jqueryui"],
        "typeRoots": ["node_modules/@types"],
        "moduleResolution": "node",
        "lib": ["es2017", "dom"],
        "skipLibCheck": true,
        "outDir": "build"
    },
    "include": [
        "src/*.ts"
    ],
    "exclude": [
        "src/*.test.ts",
        "node_modules",
        "build",
        "dist"
    ]
}
